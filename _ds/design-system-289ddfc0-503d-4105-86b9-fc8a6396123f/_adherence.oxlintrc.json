{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/social/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Royal Theatre Sans|Royal Theatre Serif|Archivo Black|Playfair Display))/i]",
        "message": "Font not provided by the design system. Available: Royal Theatre Sans, Royal Theatre Serif, Archivo Black, Playfair Display."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|color|size|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, color, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:mark|wordmark)$/]",
        "message": "<Logo> variant must be one of 'mark' | 'wordmark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NotchedBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|notch|corner|fill|outline|textColor|style|key|ref|className|style|children)$/]",
        "message": "<NotchedBadge> doesn't accept that prop. Declared props: children, notch, corner, fill, outline, textColor, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NotchedBadge'] > JSXAttribute[name.name='corner'] > Literal[value!=/^(?:tr|bl|tr-bl)$/]",
        "message": "<NotchedBadge> corner must be one of 'tr' | 'bl' | 'tr-bl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillSticker'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|fill|textColor|icon|rotate|key|ref|className|style|children)$/]",
        "message": "<PillSticker> doesn't accept that prop. Declared props: children, fill, textColor, icon, rotate."
      },
      {
        "selector": "JSXOpeningElement[name.name='PosterCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|eyebrow|titleTop|titleBottom|dateText|bodyText|fill|width|key|ref|className|style|children)$/]",
        "message": "<PosterCard> doesn't accept that prop. Declared props: image, eyebrow, titleTop, titleBottom, dateText, bodyText, fill, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='StickerCircle'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|ring|ringColor|size|caption|key|ref|className|style|children)$/]",
        "message": "<StickerCircle> doesn't accept that prop. Declared props: image, ring, ringColor, size, caption."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Logo": {
        "replaces": []
      },
      "NotchedBadge": {
        "replaces": []
      },
      "PillSticker": {
        "replaces": []
      },
      "PosterCard": {
